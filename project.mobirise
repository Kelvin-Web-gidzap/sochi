          "_customHTML": "<!-- Type valid HTML here -->\n\n<div>\n<iframe src=\"https://yandex.ru/map-widget/v1/?um=constructor%3Ac2d3d48057d8450ad4c1ca87b5523ba07217d390b6caf908f102d463d97730b6&amp;source=constructor\" width=\"1000\" height=\"300\" frameborder=\"0\"></iframe>\n</div>",
