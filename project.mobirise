              }
            },
            ".mbr-section-title": {
              "width": "100%",
              "color": "#000000",
              "margin-bottom": "16px",
              "@media (max-width: 767px)": {
                "text-align": "center !important"
              }
            },
            ".mbr-text": {
              "letter-spacing": "inherit",
              "color": "#ffffff",
              "width": "100%",
              "margin-bottom": "16px",
              "@media (max-width: 767px)": {
                "text-align": "center !important"
              }
            },
            ".item": {
              "display": "flex",
              "align-items": "center",
              "margin": "12px 0"
            },
            ".btn-container": {
              "width": "100%",
              "margin-top": "22px"
            },
            ".mbr-section-btn": {
              "@media (max-width: 767px)": {
                "text-align": "center !important"
              },
              "@media (max-width: 575px)": {
                "display": "flex",
                "flex-wrap": "wrap",
                "& .btn": {
                  "width": "100%"
                }
              }
            },
            ".form-container": {
              "padding": "30px",
              "background-color": "rgba(0, 0, 0, 0.8)",
              "@media (min-width: 768px)": {
                "max-width": "22rem",
                "margin": "0 auto"
              },
              "@media (max-width: 767px)": {
                "text-align": "center !important"
              }
            },
            ".form-title": {
              "color": "#ffffff",
              "margin-bottom": "40px",
              "@media (max-width: 767px)": {
                "text-align": "center !important"
              }
            },
            ".form-control": {
              "font-size": "1rem"
            },
            ".mbr-fallback-image.disabled": {
              "display": "none"
            },
            ".mbr-fallback-image": {
              "display": "block",
              "background-size": "cover",
              "background-position": "center center",
